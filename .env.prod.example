# Used by docker-compose.prod.yml directly (separate from backend/.env,
# which the backend container reads on its own via env_file).
#
# NOTE: this stack is backend-only now. Both frontends (public site AND
# admin dashboard) deploy separately on Vercel — see the root README's
# "Deploying to Vercel" sections. Their VITE_* build-time env vars are
# set in the Vercel project settings, not here.

DB_NAME=event_platform
DB_USER=postgres
DB_PASSWORD=change-me

# Port this stack is served on:
#
#   http://<address>:<port>/api/v1/...  Django REST API
#   http://<address>:<port>/django-admin Django's built-in admin site
#
# 80 is the default, which means no port in the URL at all. Change it if
# something else already owns port 80 on the machine (e.g. 8080).
HTTP_PORT=80

# The address Caddy serves on (see Caddyfile). Leave unset/`:80` for a
# bare IP with no TLS. Vercel-hosted frontends are always served over
# HTTPS, and browsers block HTTPS pages from calling a plain http://
# backend ("mixed content"), so before connecting real frontends to this,
# set this to an https:// hostname instead — either a free sslip.io
# address derived from your Elastic IP (no domain purchase needed:
# 15.240.170.199 -> https://15-240-170-199.sslip.io) or a real domain
# pointed at the same IP. Caddy fetches a real Let's Encrypt cert
# automatically the first time it's hit on that hostname. Also requires
# port 443 open in the EC2 security group.
SITE_ADDRESS=:80

# --- Database backups (infra/backup-db.sh, run via cron — see infra/README.md) ---
# S3 bucket name for offsite backup uploads. Leave blank to keep backups
# local-only (still written to $BACKUP_DIR, just never leaves the box).
BACKUP_S3_BUCKET=
# How many days of local .sql.gz backups to keep before deleting (S3
# copies are cleaned up separately by a bucket lifecycle rule instead).
BACKUP_RETENTION_DAYS=7
