# Single-origin, no-domain deployment for the backend API only. Neither
# frontend is served here — the public registration site AND the admin
# dashboard both deploy separately on Vercel and talk to this backend
# cross-origin (see CORS_ALLOWED_ORIGINS in backend/.env and the root
# README's "Deploying to Vercel" sections).
#
# Everything below is served from one address on port 80 — localhost, a
# LAN IP, an EC2 public IP, whatever you deploy on.
#
#   http://<address>/api/v1/...     → Django REST API
#   http://<address>/django-admin   → Django's built-in admin site
#   http://<address>/static|/media  → Django static + uploaded files
#
# `:80` matches any hostname, so nothing here needs to change when you
# later buy a domain — see the README for the HTTPS switch-over.

:80 {
	# Django's own static/media (admin site CSS, uploaded files) served
	# directly by Caddy from the shared volumes, everything else goes to
	# gunicorn.
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle_path /media/* {
		root * /srv/media
		file_server
	}

	# Django REST API — prefix is NOT stripped, the backend's urls.py
	# already expects /api/v1/...
	handle /api/* {
		reverse_proxy backend:8000
	}

	# Django's built-in admin site (not the React admin dashboard, which
	# is a separate Vercel deployment — kept at /django-admin/ rather
	# than /admin/ just to keep that distinction unambiguous).
	handle /django-admin/* {
		reverse_proxy backend:8000
	}

	# Nothing lives at root anymore — both frontends are on Vercel.
	# Unmatched paths 404, which is correct.
}
