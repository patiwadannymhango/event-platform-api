# --- Django ---
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
# Every address the site is reached by. With no domain, that's localhost
# plus the server's IP — e.g. 127.0.0.1,localhost,13.51.72.9
# `*` accepts any Host header; fine while you're finding your feet, but
# narrow it to the real addresses once you know them.
ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=config.settings.development

# Full https://host origin(s) allowed to submit django-admin logins etc.
# Only matters in production, behind Caddy's TLS termination — set this to
# match SITE_ADDRESS in .env.prod, e.g.
# CSRF_TRUSTED_ORIGINS=https://15-240-170-199.sslip.io
CSRF_TRUSTED_ORIGINS=

# --- Database (Postgres) ---
DB_NAME=event_platform
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# --- CORS ---
# Local dev: the two frontends run on their own Vite ports (5173/5174),
# cross-origin from this backend, hence both being listed below.
#
# Production: BOTH frontends are cross-origin from this backend now —
# the public registration site AND the admin dashboard each deploy
# separately on Vercel (see the root README's "Deploying to Vercel"
# sections), while this backend runs alone on AWS. Their real Vercel
# domains (e.g. https://your-public-site.vercel.app,
# https://your-admin.vercel.app, plus any custom domains) MUST be added
# here, or every API call from them will fail with a CORS error. Vercel
# preview deployments get their own random subdomain per deploy; add
# those too if you need previews to reach a real backend.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Email (Gmail SMTP) ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- SMS (pluggable — see apps/notifications/sms.py) ---
SMS_BACKEND=console
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# --- Lipila ---
LIPILA_ENVIRONMENT=sandbox
LIPILA_SANDBOX_API_KEY=
LIPILA_PRODUCTION_API_KEY=
LIPILA_WEBHOOK_SECRET=
LIPILA_DISBURSEMENT_ENDPOINT=/api/v1/disbursements/mobile-money
LIPILA_BALANCE_ENDPOINT=/api/v1/merchants/balance

# --- This event ---
CURRENT_EVENT_ID=

# --- Bank transfer details shown to runners (Bank Transfer payment method) ---
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=
BANK_SORT_CODE=
BANK_SWIFT_CODE=
